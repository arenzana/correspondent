{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDirs": [
      "..",
      "svelte"
    ],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    "incremental": false,
    "tsBuildInfoFile": "tsbuildinfo.json"
  },
  "files": [
    "../node_modules/svelte-check/dist/src/svelte-shims-v4.d.ts",
    "../node_modules/svelte/svelte-html.d.ts"
  ],
  "include": [
    "../src/**/*.ts",
    "../src/**/*.svelte",
    "svelte/src/**/*.ts",
    "svelte/src/**/*.d.svelte.ts"
  ],
  "exclude": [
    "../src/App.svelte",
    "../src/components/AddFeed.svelte",
    "../src/components/Article.svelte",
    "../src/components/FeedIcon.svelte",
    "../src/components/Icon.svelte",
    "../src/components/Login.svelte",
    "../src/components/Modal.svelte",
    "../src/components/Palette.svelte",
    "../src/components/Pulse.svelte",
    "../src/components/ReadingSettings.svelte",
    "../src/components/Settings.svelte",
    "../src/components/Shortcuts.svelte",
    "../src/components/Sidebar.svelte",
    "../src/components/Toasts.svelte",
    "../src/components/Wire.svelte"
  ]
}